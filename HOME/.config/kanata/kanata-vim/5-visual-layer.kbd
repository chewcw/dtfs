;; ----------------
;; vim visual layer
;; ----------------
;;
(deflayermap (vim-visual)
  esc   (multi @deselect @switch-vim-normal)
  h     @select-left
  j     @select-down
  k     @select-up
  l     @select-right
  lft   @select-left
  down  @select-down
  up    @select-up
  rght  @select-right
  b     @select-start-of-word
  e     @select-end-of-word
  w     (switch
          ((input-history real i 2))
            @select-word                ;; combo ([v] iw)
            break
          ()
            @select-end-of-word         ;; aka ([v] w)
            break
        )
  0     @select-start-of-line
  n     @n-meta-vim
  i     @i-meta-vim
  m     @m-meta-vim
  g     (tap-dance 200
          ((t! action-shift XX
            @select-end-of-page)        ;; shift  tap (G)
          @select-start-of-page))       ;; double tap (gg)
  c     (multi @cut @line-paste-off @switch-insert)
  d     (fork
          (multi @cut @line-paste-off @switch-vim-normal)  ;; tap     (d)
          @select-half-page-down                           ;; ctl tap (C-d)
          (lctl rctl))
  u     (fork
          XX
          @select-half-page-up                             ;; ctl tap (C-u)
          (lctl rctl))
  x     (multi @cut @line-paste-off @switch-vim-normal)
  p     (multi @paste @switch-vim-normal)
  y     (multi (macro @copy @deselect) @line-paste-off @switch-vim-normal)
  4     (fork _ @select-end-of-line (lsft rsft))           ;; shift 4 ($) intact
  -     (fork _ @select-start-of-line (lsft rsft))         ;; shift - (_) intact

  ;; loop modifiers to the vim layer
  ;; (lmet is the shared tap-hold: tap -> base, hold -> real met;
  ;; rmet stays a no-op here, nop1 keeps met+n/met-i switching alive)
  rctl  rctl
  lctl  lctl
  lmet  @lmet-to-base
  rmet  nop1
  lalt  lalt
  ralt  @ralt-function-row
  lsft  lsft
  rsft  rsft

  ;; block any other key presses
  ___   XX
)
