;; ----------------
;; vim visual layer
;; ----------------
;;
(deflayermap (vim-visual)
  esc   (fork (multi @deselect @switch-vim-normal) _ (lmet rmet))
  h     (fork @select-left  _ (lmet rmet))
  j     (fork @select-down  _ (lmet rmet))
  k     (fork @select-up    _ (lmet rmet))
  l     (fork @select-right _ (lmet rmet))
  lft   (fork @select-left  _ (lmet rmet))
  down  (fork @select-down  _ (lmet rmet))
  up    (fork @select-up    _ (lmet rmet))
  rght  (fork @select-right _ (lmet rmet))
  b     (fork @select-start-of-word _ (lmet rmet))
  e     (fork @select-end-of-word   _ (lmet rmet))
  w     (fork (switch
          ((input-history real i 2))
            @select-word                ;; combo ([v] iw)
            break
          ()
            @select-end-of-word         ;; aka ([v] w)
            break
        )
          _
          (lmet rmet))
  0     (fork @select-start-of-line _ (lmet rmet))
  n     @n-meta-vim
  i     @i-meta-vim
  g     (fork (tap-dance 200
          ((t! action-shift XX
            @select-end-of-page)        ;; shift  tap (G)
          @select-start-of-page))       ;; double tap (gg)
          _
          (lmet rmet))
  c     (fork (multi @cut @line-paste-off @switch-insert) _ (lmet rmet))
  d     (fork (fork
          (multi @cut @line-paste-off @switch-vim-normal)  ;; tap     (d)
          @select-half-page-down                           ;; ctl tap (C-d)
          (lctl rctl))
          _
          (lmet rmet))
  u     (fork (fork
          XX
          @select-half-page-up                             ;; ctl tap (C-u)
          (lctl rctl))
          _
          (lmet rmet))
  x     (fork (multi @cut @line-paste-off @switch-vim-normal) _ (lmet rmet))
  p     (fork (multi @paste @switch-vim-normal) _ (lmet rmet))
  y     (fork (multi (macro @copy @deselect) @line-paste-off @switch-vim-normal) _ (lmet rmet))
  4     (fork (fork _ @select-end-of-line (lsft rsft)) _ (lmet rmet))           ;; shift 4 ($) intact, met 4 passthrough
  -     (fork (fork _ @select-start-of-line (lsft rsft)) _ (lmet rmet))        ;; shift - (_) intact, met - passthrough

  ;; loop modifiers to the vim layer
  rctl  rctl
  lctl  lctl
  lmet  lmet
  rmet  rmet
  lalt  lalt
  ralt  @to-base
  lsft  lsft
  rsft  rsft

  ;; block any other key presses, unless met is held (M-<key> OS shortcut passthrough)
  ___   (fork XX _ (lmet rmet))
)
