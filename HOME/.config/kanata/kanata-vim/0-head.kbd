;; ------------------------------------------------------------
;; Shared head: defcfg + generic aliases (NO layers in here!)
;; Keep this included BEFORE the per-layout file so that
;; (deflayer base ...) from the layout stays the FIRST layer
;; definition (index 0 = startup layer).
;; ------------------------------------------------------------
(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  alias-to-trigger-on-load switch-base
)

;; ------------------------------------------------------------
;; Special keys (from original kanata-75)
;; ------------------------------------------------------------
(defalias
  esc-caps caps
  left-ctrl-esc esc
  caps-ctrl (tap-hold 100 100 esc lctl)
)

;; ------------------------------------------------------------
;; Layer switching (plugin provides switch-vim-normal etc.)
;; ------------------------------------------------------------
(defalias
  to-normal  @switch-vim-normal
  to-insert  @switch-insert
  to-visual  @switch-vim-visual
  to-base    @switch-base
  ;; insert mode: tap caps -> normal, hold caps -> ctrl-layer helpers
  caps-to-normal (tap-hold 100 100 @switch-vim-normal (layer-while-held ctrl-layer))
)

;; ------------------------------------------------------------
;; met+n -> normal, met+i -> insert (from ANY mode)
;; Fork on met held: otherwise preserve the plain key behavior.
;; Meta output is only available in base mode: in every other mode
;; the met keys map to no-op outputs (nop0/nop1) that stay visible
;; to fork, so these chords keep working everywhere.
;; - *_meta:      for base layer (plain n/i passthrough, real met held)
;; - *_meta-ins:  for insert layer (plain n/i passthrough, met -> nop0/nop1)
;; - *_meta-vim:  for vim layers (plain key is blocked = XX)
;; ------------------------------------------------------------
(defalias
  n-meta      (fork n  @switch-vim-normal (lmet rmet))
  i-meta      (fork i  @switch-insert     (lmet rmet))
  n-meta-ins  (fork n  @switch-vim-normal (nop0 nop1))
  i-meta-ins  (fork i  @switch-insert     (nop0 nop1))
  n-meta-vim  (fork XX @switch-vim-normal (nop0 nop1))
  i-meta-vim  (fork XX @switch-insert     (nop0 nop1))
)
