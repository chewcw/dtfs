;; ------------------------------------------------------------
;; Shared head: defcfg + generic aliases (NO layers in here!)
;; Keep this included BEFORE the per-layout file so that
;; (deflayer base ...) from the layout stays the FIRST layer
;; definition (index 0 = startup layer).
;; ------------------------------------------------------------
(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  alias-to-trigger-on-load switch-base
  movemouse-smooth-diagonals yes
  movemouse-inherit-accel-state yes
)

;; ------------------------------------------------------------
;; Special keys (from original kanata-75)
;; ------------------------------------------------------------
(defalias
  esc-caps caps
  left-ctrl-esc esc
  caps-ctrl (tap-hold 100 150 esc lctl)
  caps-ctrl-only lctl
)

;; ------------------------------------------------------------
;; Layer switching (plugin provides switch-vim-normal etc.)
;; ------------------------------------------------------------
(defalias
  to-normal  @switch-vim-normal
  to-insert  @switch-insert
  to-visual  @switch-vim-visual
  ;; lmet tap-hold (every layer): tap -> base, hold -> real met.
  ;; tap-hold-press resolves as hold when another key is pressed, so
  ;; met+n / met+i chords and cmd-combos still work when rolled fast.
  lmet-to-base (tap-hold-press 100 150 @switch-base lmet)
  ;; insert mode: tap caps -> normal, hold caps -> ctrl-layer helpers
  caps-to-normal (tap-hold 100 150 @switch-vim-normal (layer-while-held ctrl-layer))
  ;; insert mode: lalt is a REAL alt modifier, so every chord reaches the
  ;; app as alt+key (alt+enter, alt+f4, alt+left, ...). On top of that it
  ;; holds alt-layer for the word-movement helpers (alt+h/j/k/l/b/f/d);
  ;; those entries unmod alt themselves, so they still arrive as plain
  ;; cursor/word moves. Every other key is transparent in alt-layer and
  ;; falls through to the insert layer *with* alt held.
  lalt-insert (multi lalt (layer-while-held alt-layer))
)

;; ------------------------------------------------------------
;; met+n -> normal, met+i -> insert (from ANY mode)
;; Fork on met held: otherwise preserve the plain key behavior.
;; lmet is a tap-hold in every layer (tap -> base, hold -> real met),
;; so the chords check real met directly on every layer.
;; rmet stays plain in base and nop1 elsewhere (checked via nop1).
;; - *_meta:      for base + insert layers (plain n/i passthrough)
;; - *_meta-vim:  for vim layers (plain key is blocked = XX)
;; ------------------------------------------------------------
(defalias
  n-meta      (fork n  @switch-vim-normal (lmet rmet nop1))
  i-meta      (fork i  @switch-insert     (lmet rmet nop1))
  n-meta-vim  (fork XX @switch-vim-normal (lmet rmet nop1))
  i-meta-vim  (fork XX @switch-insert     (lmet rmet nop1))
)

;; ------------------------------------------------------------
;; Right-Alt: hold for the function row.
;; Hold ralt -> the transparent `function-row` overlay is active for
;; as long as the key is held, so the number row sends F1..F12.
;; There is no tap action anymore (no toggle, no virtual key): press
;; ralt+<number> for an F-key, release ralt and you are back.
;; ralt is still emitted as a real modifier, so ralt+<other key>
;; keeps behaving as alt+<key> (e.g. ralt+left = word movement).
;; ------------------------------------------------------------
(defalias
  ralt-func (multi ralt (layer-while-held function-row))
)
