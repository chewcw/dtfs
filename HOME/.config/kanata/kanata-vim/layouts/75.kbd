;; ------------------------------------------------------------
;; Layout: 75%
;; Per-keyboard file: defsrc + deflayer base + deflayer insert.
;; NOTE: base and insert must each list EXACTLY the same number of
;; keys, in the same order, as defsrc below. If you add/remove a key
;; in defsrc, update all three blocks together.
;; Everything else (vim layers, mods, overrides) is shared and lives
;; in the parent kanata-vim/*.kbd files.
;; ------------------------------------------------------------

(defsrc
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ------------------------------------------------------------
;; Base layer
;; ------------------------------------------------------------
(deflayer base
  @esc-caps
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    @i-meta    o    p    [    ]    \
  @caps-ctrl a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    @n-meta    @m-meta    ,    .    /    rsft
  lctl @lmet-to-base lalt  spc            @ralt-function-row rmet rctl
)

;; ------------------------------------------------------------
;; Insert mode
;; (lmet is the shared tap-hold: tap -> base, hold -> real met;
;; rmet stays a no-op here, nop1 stays visible to fork)
;; ------------------------------------------------------------
(deflayer insert
  @esc-caps
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    (fork i @switch-base (lmet rmet nop1))    o    p    [    ]    \
  @caps-to-normal a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    @n-meta    @m-meta    ,    .    /    rsft
  lctl  @lmet-to-base  (layer-while-held alt-layer)  spc  @ralt-function-row  nop1  rctl
)

;; ------------------------------------------------------------
;; Vim overrides (per-layout copy, identical to the old shared
;; version: 75% behavior unchanged. Shared empty scaffolds live
;; in 9-tail.kbd.)
;; ------------------------------------------------------------
(deflayermap (vim-normal-override)
  esc @esc-caps
  caps @caps-ctrl-only
  lctl @left-ctrl-esc
  1 (t! function-row-pass 1)
  2 (t! function-row-pass 2)
  3 (t! function-row-pass 3)
  4 (t! function-row-pass (fork _ @end-of-line (lsft rsft)))
  5 (t! function-row-pass 5)
  6 (t! function-row-pass 6)
  7 (t! function-row-pass 7)
  8 (t! function-row-pass 8)
  9 (t! function-row-pass 9)
  0 (t! function-row-pass @start-of-line)
  - (t! function-row-pass -)
  = (t! function-row-pass =)
  [ [  ] ]  \ \
  ; ;  ' '
  , ,  . .
  bspc bspc
  ret ret
  tab tab
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
(deflayermap (vim-visual-override)
  esc @esc-caps
  caps @caps-to-normal
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
(deflayermap (vim-visual-line-override)
  esc @esc-caps
  caps @caps-to-normal
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
