;; ------------------------------------------------------------
;; Layout: 65%
;; Per-keyboard file: defsrc + deflayer base + deflayer insert.
;; NOTE: base and insert must each list EXACTLY the same number of
;; keys, in the same order, as defsrc below (69 keys). If you
;; add/remove a key in defsrc, update all three blocks together.
;; Everything else (vim layers, mods, overrides) is shared and lives
;; in the parent kanata-vim/*.kbd files.
;;
;; Board map (right nav column APPENDED, arrows split):
;;   row0: esc                        -> sends grv in base/insert
;;   row1: 1..0 - = bspc grv           (no left grave; far-right grv -> caps, all layers)
;;   row2: tab q..p [ ] \  + del
;;   row3: caps a..l ; ' ret + pgup
;;   row4: lsft z..m , . / rsft + up + pgdn
;;   row5: lctl lmet lalt spc ralt fn rctl left down rght
;; ------------------------------------------------------------

(defsrc
  esc
  1    2    3    4    5    6    7    8    9    0    -    =    bspc grv
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    del
  caps a    s    d    f    g    h    j    k    l    ;    '    ret  pgup
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up   pgdn
  lctl lmet lalt           spc            ralt fn   rctl left down rght
)

;; ------------------------------------------------------------
;; Base layer
;; ------------------------------------------------------------
(deflayer base
  grv
  1    2    3    4    5    6    7    8    9    0    -    =    bspc caps
  tab  q    w    e    r    t    y    u    @i-meta    o    p    [    ]    \    del
  @caps-ctrl a    s    d    f    g    h    j    k    l    ;    '    ret  pgup
  lsft z    x    c    v    b    @n-meta    m    ,    .    /    rsft up   pgdn
  lctl lmet lalt           spc            @to-base fn   rctl left down rght
)

;; ------------------------------------------------------------
;; Insert mode
;; ------------------------------------------------------------
(deflayer insert
  grv
  1    2    3    4    5    6    7    8    9    0    -    =    bspc caps
  tab  q    w    e    r    t    y    u    @i-meta    o    p    [    ]    \    del
  (layer-while-held ctrl-layer) a    s    d    f    g    h    j    k    l    ;    '    ret  pgup
  lsft z    x    c    v    b    @n-meta    m    ,    .    /    rsft up   pgdn
  (layer-while-held ctrl-layer)  lmet  (layer-while-held alt-layer)           spc            @to-base  fn  rctl  left  down  rght
)

;; ------------------------------------------------------------
;; Vim overrides (per-layout copy: far-right grv key stays caps
;; in vim modes too. Shared empty scaffolds live in 9-tail.kbd.)
;; ------------------------------------------------------------
(deflayermap (vim-normal-override)
  esc @esc-caps
  caps @caps-ctrl
  grv caps
  1 1  2 2  3 3  4 (fork _ @end-of-line (lsft rsft))  5 5  6 6  7 7  8 8  9 9  0 @start-of-line
  - -  = =
  [ [  ] ]  \ \
  ; ;  ' '
  , ,  . .
  bspc bspc
  ret ret
  tab tab
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
(deflayermap (vim-visual-override)
  esc @esc-caps
  caps @caps-ctrl
  grv caps
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
(deflayermap (vim-visual-line-override)
  esc @esc-caps
  caps @caps-ctrl
  grv caps
  del del
  pgup pgup
  pgdn pgdn
  fn fn
)
