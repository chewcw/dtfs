;; ------------
;; Function-row state
;; ------------
;;
;; Defined before the mode-switch template so status publishing can
;; check the virtual key directly.
(defvar
  function-row-tap-timeout  100
  function-row-hold-timeout 150
)

(defvirtualkeys
  function-row-active (layer-while-held function-row)
)

;; ------------
;; Switch Vim Modes
;; ------------
;;
;; Takes care of switching between vim modes:
;; - insert
;; - normal
;; - visual
;; - visual-line
;;
;; When entering one of these modes:
;; - switch to the <vim-mode> layer
;; - activate the corresponding overlay layer
;; - execute mode-specific actions
;;
(deftemplate switch- (target-layer mode action)
  (defvirtualkeys
    (concat layer-switch-   $target-layer)
    (layer-switch $target-layer)
  )

  (defvirtualkeys
    (concat override-layer- $target-layer)
    (layer-while-held (concat $target-layer -override))
  )

  (defalias
    (concat switch- $target-layer)
    (multi
      $action

      ;; Publish current vim mode to i3
      (switch
        ((input virtual function-row-active))
          (cmd sh -c
            (concat
              "mkdir -p /home/ccw/.cache && "
              "printf '%s' "
              $mode
              "-FUNC"
              " > /home/ccw/.cache/kanata-mode"
            )
          )
          break
        ()
          (cmd sh -c
            (concat
              "mkdir -p /home/ccw/.cache && "
              "printf '%s' "
              $mode
              " > /home/ccw/.cache/kanata-mode"
            )
          )
          break
      )

      (macro
        ;; Release ALL mode overrides first (releasing an unheld
        ;; vkey is a no-op). The old 3-param version only released
        ;; vim overrides and leaked one layer-while-held per switch,
        ;; stacking duplicates until MAX_ACTIVE_LAYERS=12.
        (on-press release-vkey override-layer-base)
        (on-press release-vkey override-layer-insert)
        (on-press release-vkey override-layer-mouse)
        (on-press release-vkey override-layer-vim-normal)
        (on-press release-vkey override-layer-vim-visual)
        (on-press release-vkey override-layer-vim-visual-line)
        (on-press tap-vkey     (concat layer-switch-   $target-layer))
        (on-press press-vkey   (concat override-layer- $target-layer))
      )
    )
  )
)

(t! switch- insert
    INSERT
    @line-paste-off
)

(t! switch- base
    BASE
    nop0
)

(t! switch- vim-normal
    NORMAL
    nop0
)

(t! switch- vim-visual
    VISUAL
    nop0
)

(t! switch- vim-visual-line
    VISUAL-LINE
    @select-line
)


;; ------------
;; Enter Vim (normal mode)
;; ------------
;;
;; Helper template for application-aware activation of vim mode.
;;
;; $modifier:
;;   If this key is pressed, enter vim mode.
;;
;; vim-direct-enter:
;;   If this virtual key is active, immediately enter vim mode.
;;
;; Use a script and the Kanata TCP server to toggle the
;; vim-direct-enter layer for certain applications.
;;

(defvirtualkeys vim-direct-enter ())

(deftemplate vim-entrypoint (modifier)
  (switch
    ((input virtual vim-direct-enter))
      @switch-vim-normal
      break

    ()
      (fork _ @switch-vim-normal ($modifier))
      break
  )
)
