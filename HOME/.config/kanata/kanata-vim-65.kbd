;; kanata-vim-65.kbd — thin wrapper for 65% boards.
;; Shared logic lives in kanata-vim/*.kbd (the "parent").
;; Board-specific keys live in kanata-vim/layouts/65.kbd
;; (defsrc + deflayer base + deflayer insert).
;;
;; NOTE: (deflayer base ...) inside layouts/65.kbd must stay the FIRST
;; layer definition in expanded file order (deflayer AND deflayermap
;; share one index space, and index 0 is the startup layer). So keep
;; 0-head.kbd layer-free and keep the layout include before 4/5/6/8/9.

(include kanata-vim/1-interface.kbd)
(include kanata-vim/2-shared.kbd)
(include kanata-vim/3-bootstrapping.kbd)
(include kanata-vim/0-head.kbd)
(include kanata-vim/layouts/65.kbd)
(include kanata-vim/4-normal-layer.kbd)
(include kanata-vim/5-visual-layer.kbd)
(include kanata-vim/6-visual-line-layer.kbd)
(include kanata-vim/8-mods.kbd)
(include kanata-vim/9-tail.kbd)
;; (include kanata-cmd.kbd)
